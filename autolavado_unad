# MODELO DE DATOS (POO / ENCAPSULAMIENTO)
# ==============================================================================


class Usuario:
    """Clase que gestiona la autenticación del usuario del sistema."""

    def __init__(self):
        # Atributos privados requeridos por la guía
        self._usuario = "programacion"
        self._password = "programacion"

    def validar(self, usuario_ingresado: str, password_ingresada: str) -> bool:
        """Valida credenciales contra atributos privados."""
        return (
            self._usuario == usuario_ingresado
            and self._password == password_ingresada
        )


class AutoLavado:
    """Clase que representa un vehículo dentro del sistema de autolavado."""

    def __init__(self, placa: str, tarifa_hora: float):
        # Atributos privados requeridos por la guía
        self._placa = placa.upper().strip()
        self._hora_ingreso = 0.0  # Almacenado internamente en formato 24h
        self._hora_salida = 0.0   # Almacenado internamente en formato 24h
        self._tarifa_hora = tarifa_hora
        self._estado = "In Service"  # Estado del vehículo
        self._valor_cobrado = 0.0    # Valor total cobrado al finalizar

    def registrar_ingreso(self, hora_24h: float) -> None:
        """Registra la hora de ingreso del vehículo."""
        self._hora_ingreso = hora_24h

    def registrar_salida(self, hora_24h: float) -> None:
        """Registra la hora de salida del vehículo y calcula el monto cobrado."""
        self._hora_salida = hora_24h
        self._estado = "Completed"
        self._valor_cobrado = self.calcular_pago(hora_24h)

    def calcular_pago(self, hora_salida_24h: float) -> float:
        """Calcula el costo total cobrado por horas o fracción de hora."""
        tiempo_transcurrido = hora_salida_24h - self._hora_ingreso
        horas_cobradas = math.ceil(tiempo_transcurrido)
        return horas_cobradas * self._tarifa_hora

    def obtener_placa(self) -> str:
        """Retorna la placa del vehículo para identificación."""
        return self._placa


# ==============================================================================
# FUNCIONES AUXILIARES DE CONVERSIÓN DE HORA (12h AM/PM <-> 24h)
# ==============================================================================


def convertir_a_24h(hora_12h: float, am_pm: str) -> float:
    """Convierte una hora en formato 12h y su prefijo AM/PM a formato decimal 24h."""
    am_pm = am_pm.upper().strip()
    if hora_12h < 1 or hora_12h > 12:
        raise ValueError("Hour value must be between 1 and 12 for 12-hour format.")

    if am_pm == "AM":
        return 0.0 if hora_12h == 12 else hora_12h
    elif am_pm == "PM":
        return 12.0 if hora_12h == 12 else hora_12h + 12.0
    else:
        raise ValueError("Invalid period format. Use AM or PM.")


def formatear_12h(hora_24h: float) -> str:
    """Convierte un valor flotante en formato 24h a una cadena legible en formato 12h AM/PM."""
    horas_enteras = int(hora_24h)
    minutos = int(round((hora_24h - horas_enteras) * 60))

    periodo = "AM"
    if horas_enteras >= 12:
        periodo = "PM"

    hora_12 = horas_enteras % 12
    if hora_12 == 0:
        hora_12 = 12

    return f"{hora_12:02d}:{minutos:02d} {periodo}"


